{
  "name": "exresume",
  "private": true,
  "version": "1.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "build": "tsc --noEmit && vite build",
    "package": "npm run check && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "demo": "vite demo --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run icons && npm run test && npm run build"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.94.0",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
